{
  "name": "kaleidoscope-server",
  "version": "1.2.1",
  "type": "module",
  "license": "MIT",
  "description": "Kaleidoscope backend API server",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx index.ts",
    "build": "esbuild index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "test": "tsx --test **/*.test.ts",
    "test:security": "tsx --test utils/security.test.ts"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "element-source": "^0.0.5",
    "express": "^4.21.2",
    "playwright-core": "^1.59.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/node": "^20.19.11",
    "cross-env": "^10.0.0",
    "esbuild": "^0.27.4",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  }
}
