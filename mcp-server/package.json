{
  "name": "kaleidoscope-mcp-server",
  "version": "1.2.5",
  "type": "module",
  "description": "MCP server for Kaleidoscope - responsive design preview tool",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "kaleidoscope",
    "responsive",
    "screenshots",
    "playwright"
  ],
  "homepage": "https://github.com/Nathanael-R/kaleidoscope#readme",
  "bugs": {
    "url": "https://github.com/Nathanael-R/kaleidoscope/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nathanael-R/kaleidoscope.git",
    "directory": "mcp-server"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "kaleidoscope-mcp": "dist/index.js"
  },
  "scripts": {
    "dev": "npm run build:mcp-app && tsx src/index.ts",
    "build": "npm run build:mcp && npm run build:app",
    "build:mcp": "npm run build:mcp-app && esbuild src/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "build:mcp-app": "node scripts/build-mcp-app.mjs",
    "build:app": "node scripts/build-packaged-app.mjs",
    "start": "node dist/index.js",
    "check": "node ./scripts/typecheck.mjs && tsc -p tsconfig.browser.json",
    "test": "npm run build:mcp-app && tsx --test src/**/*.test.ts app/**/*.test.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && npm run check && npm test",
    "publish:check": "npm run prepublishOnly && npm publish --dry-run --access public",
    "publish:public": "npm publish --access public"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "element-source": "^0.0.5",
    "express": "^4.22.2",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.59.1",
    "pngjs": "^7.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "@types/node": "^20.19.11",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.0",
    "typescript": "^5.9.2"
  }
}
